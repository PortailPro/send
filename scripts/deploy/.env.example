# Portailpro Send - configuration
# Copier ce fichier en ".env" à côté de package.json : il est lu par `npm run prod`.
# Toutes les variables possibles : server/config.js

# --- Indispensable ---------------------------------------------------------
# URL publique du service (utilisée pour générer les liens de partage)
BASE_URL=https://send.example.com
PORT=1443
# IP_ADDRESS=0.0.0.0

# "production" : logs JSON et Redis obligatoire.
# "development" sans REDIS_HOST : métadonnées en mémoire (perdues au redémarrage).
NODE_ENV=production

# --- Redis (métadonnées des fichiers) --------------------------------------
REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=

# --- Stockage des fichiers -------------------------------------------------
# Par défaut : ./datas (dans le dossier de l'application)
# FILE_DIR=/var/lib/portailpro-send
# Ou S3 / GCS :
# S3_BUCKET=
# S3_ENDPOINT=
# GCS_BUCKET=

# --- Limites (valeurs PortailPro par défaut) -------------------------------
# MAX_FILE_SIZE=10737418240
# EXPIRE_TIMES_SECONDS=300,3600,86400,604800,2592000
# DEFAULT_EXPIRE_SECONDS=86400
# MAX_EXPIRE_SECONDS=2592000
# DOWNLOAD_COUNTS=1,2,3,4,5,20,50,100
# MAX_DOWNLOADS=100
